# Copie para .env (cp .env.example .env). O .env nunca é versionado.
#
# Rodando SEM Docker (npm start): DB_HOST=localhost e um Postgres seu.
# Rodando COM docker compose: DB_HOST/DB_PORT/DB_SSL/DATABASE_URL são fixados
# pelo compose (serviço "db"); aqui valem só DB_USER, DB_PASSWORD, DB_NAME,
# JWT_SECRET e PORT (porta publicada no host).

DB_HOST=localhost
DB_PORT=5432
DB_USER=infracow
DB_PASSWORD=infracow_dev_password
DB_NAME=infracow
PORT=3000
JWT_SECRET=troque-esta-chave-em-dev

# Opcional para Supabase ou outro banco em nuvem com URL única
# (tem prioridade sobre DB_HOST/DB_USER/... quando preenchida; ignorada pelo compose local)
DATABASE_URL=

# Defina como true se o banco exigir SSL e você estiver usando host/usuário/senha separados
DB_SSL=false
