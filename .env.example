# Copie para .env (cp .env.example .env). Tudo é opcional: há padrões no compose.

# --- Banco local (container "db") ---
DB_USER=infracow
DB_PASSWORD=infracow_dev_password
DB_NAME=infracow

# --- API ---
JWT_SECRET=troque-esta-chave-em-dev
API_PORT=3000

# --- Expo (Metro) ---
EXPO_PORT=8081

# URL da API como o APP enxerga (do navegador/celular, não de dentro do Docker).
#   web no mesmo PC  -> http://localhost:3000
#   celular na rede  -> http://IP_DA_SUA_MAQUINA:3000   (use `make lan`, ele preenche sozinho)
PUBLIC_API_URL=http://localhost:3000
# IP da sua máquina na rede local (para o celular achar o Metro). Vazio = só localhost.
HOST_LAN_IP=

# --- Onde estão os repositórios (padrão: pastas irmãs deste arquivo) ---
API_PATH=./InfraCow-API
MOBILE_PATH=./InfraCow-Mobile
